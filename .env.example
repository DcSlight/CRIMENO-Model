# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# Groq API key — required for groq_anomaly_worker.py
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# vlm_worker.py — set these instead of passing --backend/--vlm_model on the command line
# every run. Any of these four can still be overridden with the matching CLI flag
# (--backend, --vlm_model, --ollama-host, --gemini-api-key), which takes priority if given.

# Which VLM backend to use: "local" (default, Ollama on your GPU) or "online" (Gemini API).
# VLM_BACKEND=local

# Model id for whichever backend is active (e.g. gemma3:4b for local, gemini-3.5-flash for
# online). Leave unset to use the backend's built-in default.
# VLM_MODEL=gemma3:4b

# --backend local (default): runs vision analysis on your GPU via Ollama — no API key
# needed. Only set this if your Ollama server isn't the default http://localhost:11434
# (e.g. it's running on another host/port).
# OLLAMA_HOST=http://localhost:11434

# --backend online: required. Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
