# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# Groq API key — required for groq_anomaly_worker.py
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# vlm_worker.py runs vision analysis locally via Ollama — no API key needed.
# Only set this if your Ollama server isn't the default http://localhost:11434
# (e.g. it's running on another host/port).
# OLLAMA_HOST=http://localhost:11434
